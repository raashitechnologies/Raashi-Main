# Environment: development | staging | production
ENVIRONMENT=development

# Note: D1 and R2 bindings are used natively in Cloudflare. 
# No connection strings are required here for the database or storage.

# Frontend URLs (for password reset / verification email links / redirects)
PUBLIC_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
# FRONTEND_URL=https://your-domain.vercel.app  # Optional fallback
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Resend (optional in dev — leave blank to skip email notifications)
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL=raashitechnologies@gmail.com

# JWT Authentication — generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE-WITH-SECURE-RANDOM-KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Refresh tokens
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Brute-force protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_ACCOUNT_CREATE=3/minute
RATE_LIMIT_PUBLIC_READ=60/minute
RATE_LIMIT_ADMIN=30/minute
RATE_LIMIT_GLOBAL=100/minute

# HTTPS enforcement (set to true when behind a TLS-terminating reverse proxy)
FORCE_HTTPS=false

# Allowed hosts — comma-separated (only needed in production)
# ALLOWED_HOSTS=raashitech.com,www.raashitech.com

# Logging
LOG_LEVEL=INFO
# Log format: text (human-readable) | json (structured, for log aggregators)
LOG_FORMAT=text

# Seed script — override default seed user passwords (required in production)
# SEED_ADMIN_PASSWORD=
# SEED_COORDINATOR_PASSWORD=


